rules_version = '2';

// ============================================================================
// RÈGLES STORAGE
// ============================================================================
// Les images d'une relation sont rangées sous couples/{coupleId}/ et ne sont
// accessibles qu'à ses membres, lus dans Firestore (règles inter-services).
// Les liens de téléchargement déjà enregistrés dans les souvenirs portent un
// jeton et restent lisibles par l'app, quelles que soient ces règles.

service firebase.storage {
  match /b/{bucket}/o {

    function isCoupleMember(coupleId) {
      return request.auth != null && request.auth.uid in
        firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
    }

    match /couples/{coupleId}/{allPaths=**} {
      allow read, delete: if isCoupleMember(coupleId);

      // --- Images uniquement, 10 Mo au plus (elles sont compressées avant
      // --- l'envoi) ---
      allow create, update: if isCoupleMember(coupleId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
